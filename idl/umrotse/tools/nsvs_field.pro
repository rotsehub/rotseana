IF n_params() EQ 0 THEN print, "Syntax: f = nsvs_field(ra1,dec1,syn=syn)" $
ELSE BEGIN 
    nra = n_elements(ra1)
    ndec = n_elements(dec1)

    IF nra EQ ndec THEN BEGIN 

        index = intarr(nra)-1
        syn = intarr(nra)
        cam = strarr(nra)
        FOR i=0,n_elements(ra)-1 DO BEGIN 
            wcs_rotate, ra1, dec1, x, y, [ra[i],dec[i]], /origin
            fid = where(x LT 8 AND x GT -8 AND y LT 8 AND y GT -8, nfid)
            IF nfid GT 0 THEN BEGIN 
                FOR j=0,nfid-1 DO BEGIN 
                    IF index[fid[j]] LT 0 THEN index[fid[j]]=i+1 ELSE $
                      syn[fid[j]] = i+1
                ENDFOR 
            ENDIF 
        ENDFOR 
    ENDIF ELSE print, "Error: ra and dec arrays must be of same size."

;result=string('sky',index+1,'_1',cam,format='(a3,i4.4,a2,a1)')
; print,result,' is ',strtrim(string(mindist),2),' degrees from mount coords'

ENDELSE 

return,index
    
