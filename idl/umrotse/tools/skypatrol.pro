function skypatrol,ra1,dec1
;+
;
; Given an ra and a dec in degrees, this will return a string
; giving the closest skypatrol frame for rotse1.
;
;-

ra=[0.0,0.0,36.0,72.0,108.0,144.0,180.0,216.0,252.0]			;0s
ra=[ra,288.0,324.0,0.0,24.0,48.0,72.0,96.0,120.0,144.0,168.0]		;10s
ra=[ra,192.0,216.0,240.0,264.0,288.0,312.0,336.0,0.0,18.75,37.75]	;20s
ra=[ra,56.75,75.75,94.5,113.5,132.5,151.5,170.5,189.25,208.25,227.25]	;30s
ra=[ra,246.25,265.25,284.0,303.0,322.0,341.0,0.0,16.25,32.5,49.0]	;40s
